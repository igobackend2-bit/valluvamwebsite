php_value upload_max_filesize 25M
php_value post_max_size 25M
php_value max_execution_time 300
php_value max_input_time 300

RewriteEngine On

# Force HTTPS
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Force www
RewriteCond %{HTTP_HOST} !^www\. [NC]
RewriteRule ^ https://www.%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# ---- Clean URLs: hide the .php extension ----

# /index or /index.php in the address bar -> redirect to the site root
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\s/+index(\.php)?[\s?] [NC]
RewriteRule ^ / [R=301,L]

# Anyone visiting or clicking a *.php link gets sent to the extension-less URL
# (this is what makes the address bar show valluvamproducts.com/shop instead of shop.php)
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\s/+([^.\s]+)\.php[\s?] [NC]
RewriteRule ^ /%1 [R=301,L,QSA]

# Internally serve the matching .php file for the clean URL, without changing the address bar
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.*)$ $1.php [L,QSA]
