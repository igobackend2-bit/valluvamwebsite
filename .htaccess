RewriteEngine On

# Force HTTPS
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Force www
RewriteCond %{HTTP_HOST} !^www\. [NC]
RewriteRule ^ https://www.%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# --- DIAGNOSTIC TEST 3: unconditional internal rewrite, brand-new test path ---
# If this works, /testroute123 will show the About page content.
RewriteRule ^testroute123$ about.php [L]
