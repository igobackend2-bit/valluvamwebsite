php_value upload_max_filesize 25M
php_value post_max_size 25M
php_value max_execution_time 300
php_value max_input_time 300

# ---- SESSION FIX (25 Sep 2026): PHP's default admin session only lasts
# ~24 minutes of inactivity (session.gc_maxlifetime default = 1440s). Any
# admin page that's left open while filling in a longer form (e.g. typing
# a product's name/price/category/quantity/description/benefits) can sit
# idle past that window - the page still looks fine since it's already
# loaded, but the save/update request then gets rejected as
# "Unauthorized - please log in to the admin panel" because the server
# already garbage-collected the session. Extended to 8 working hours so a
# logged-in admin isn't silently signed out mid-task.
php_value session.gc_maxlifetime 28800
php_value session.cookie_lifetime 28800

# ---- SPEED FIX (24 Sep 2026): the site had no gzip compression and no
# browser-cache headers at all, so every visitor re-downloaded the full,
# uncompressed CSS/JS/font/image bytes on every single page view. Both
# blocks below are wrapped in <IfModule> so they are silently skipped (no
# error) if a module isn't enabled on the server - nothing else changes.

# Compress text-based responses in transit (CSS/JS/HTML/fonts shrink ~70-80%)
<IfModule mod_deflate.c>
	AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
	AddOutputFilterByType DEFLATE application/javascript application/x-javascript
	AddOutputFilterByType DEFLATE application/json application/xml
	AddOutputFilterByType DEFLATE font/ttf font/otf application/font-woff application/font-woff2 font/woff2 image/svg+xml
</IfModule>

# Let the browser cache static assets instead of re-fetching them every visit
<IfModule mod_expires.c>
	ExpiresActive On
	ExpiresByType image/jpg "access plus 1 year"
	ExpiresByType image/jpeg "access plus 1 year"
	ExpiresByType image/png "access plus 1 year"
	ExpiresByType image/webp "access plus 1 year"
	ExpiresByType image/gif "access plus 1 year"
	ExpiresByType image/svg+xml "access plus 1 year"
	ExpiresByType image/x-icon "access plus 1 year"
	ExpiresByType text/css "access plus 1 month"
	ExpiresByType application/javascript "access plus 1 month"
	ExpiresByType font/ttf "access plus 1 year"
	ExpiresByType font/otf "access plus 1 year"
	ExpiresByType application/font-woff "access plus 1 year"
	ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

RewriteEngine On

# NOTE: HTTPS and www are already enforced upstream by the hosting platform's
# proxy (that's why the site was already always loading as https before) -
# they are NOT handled here. Do not re-add a "force HTTPS" / "force www"
# RewriteCond on %{HTTPS} or %{HTTP_HOST} in this file: Apache sits behind
# that proxy and only ever sees plain HTTP internally, so a rule like that
# redirects forever (ERR_TOO_MANY_REDIRECTS) now that .htaccess is actually
# being read.

# ---- SECURITY FIX (23 Sep 2026): block files that must never be public ----
# These were all downloadable from the live site (including .env with the
# DB / Razorpay / SMTP secrets and the whole .git folder). Returns 404.
# Placed before the clean-URL rules so nothing below can re-expose them.

# Any path segment starting with "." (.env, .git/, .htaccess, .DS_Store,
# .gitignore ...) except /.well-known/ (used for SSL certificate checks)
RewriteCond %{REQUEST_URI} !^/\.well-known/
RewriteRule (^|/)\. - [R=404,L]

# Source / build / backup / dump files
RewriteRule \.(md|sql|zip|rar|bat|sh|lock|log|config|ini|bak|env)$ - [R=404,L,NC]
RewriteRule (^|/)(Dockerfile|composer\.json|composer\.lock|dom-dump\.html)$ - [R=404,L,NC]

# .txt files (contact-form submissions are saved as .txt under assets/)
# except the two public ones
RewriteCond %{REQUEST_URI} !^/(robots|llms)\.txt$ [NC]
RewriteRule \.txt$ - [R=404,L,NC]

# Composer packages, the duplicate site copy, and duplicate nested folders
RewriteRule ^(vendor|valluvam)(/|$) - [R=404,L,NC]
RewriteRule ^assets/(assets|db_query/db_query|js/js)(/|$) - [R=404,L,NC]

# Never execute scripts from the upload folder
RewriteRule ^assets/uploads/.*\.(php\d?|phtml|phar|pl|py|cgi)$ - [R=404,L,NC]

# Unprotected dev / one-time / test scripts and unused leftover pages
RewriteRule ^(save|fetch|add_db|add_product|add_dashboard|fix_rice_category|milets|product)(\.php)?$ - [R=404,L,NC]
RewriteRule ^assets/db_query/cleanup_invalid_users\.php$ - [R=404,L,NC]

# ---- Clean URLs: hide the .php extension (top-level pages only) ----
# Only single-segment pages like shop.php / rice.php / about.php get the
# clean-URL treatment. Anything with a "/" in the path (assets/db_query/...,
# admin/..., api/...) is left completely alone, on purpose - those are
# background AJAX/data endpoints the pages themselves call, not pages a
# visitor opens, and redirecting them broke the product-loading requests.

# /index or /index.php in the address bar -> redirect to the site root
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\s/+index(\.php)?[\s?] [NC]
RewriteRule ^ / [R=301,L]

# A top-level *.php link (no further "/" in the path) redirects to the
# extension-less URL (this is what makes the address bar show
# valluvamproducts.com/shop instead of shop.php)
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\s/([^/.\s]+)\.php[\s?] [NC]
RewriteRule ^ /%1 [R=301,L,QSA]

# Internally serve the matching top-level .php file for the clean URL,
# without changing the address bar
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !/$
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^([^/]+)$ $1.php [L,QSA]

# ---- Pretty product URLs: /{category}/{product-slug} ----
# e.g. /dryfruits/dry-strawberry -> internally served by productdetail.php
# (address bar keeps showing the pretty URL).
#
# FIX (26 Sep 2026): this used to only match a hardcoded list of 7 category
# slugs (dryfruits|nuts|spices|oils|millets|rice|combo), so a product in any
# other category - e.g. "honey" - 404'd even though the product and its
# category page both work fine (valluvamproducts.com/honey/valluvam-multifloral-honey
# was the reported case). productdetail.php never actually checked that the
# first URL segment matched the product's real category anyway (it looks the
# product up by slug/id alone) - so the hardcoded list was pure friction with
# no real benefit. Replaced with an open first segment: any two-segment path
# that isn't a real file or directory (still guarded by !-f / !-d below,
# exactly as before) is treated as /{category}/{product-slug}. This means
# every category admin adds from now on - old or new - gets a working
# pretty product URL automatically, with no .htaccess edit ever needed again.
# The negative lookahead below still excludes this site's real top-level
# folders by name, so a bad/typo link inside one of them (e.g. /admin/xyz)
# keeps returning a normal 404 instead of being sent to productdetail.php.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(?!admin/|api/|assets/|css/|fonts/|images/|js/|scss/|video/|cron/|sitemap/|robot/|valluvam/)([a-zA-Z0-9-]+)/([^/]+)/?$ productdetail.php?product=$2 [L,QSA,NC]
