RewriteEngine On

# Force HTTPS
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Force www
RewriteCond %{HTTP_HOST} !^www\. [NC]
RewriteRule ^ https://www.%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# --- Clean URLs: remove .php from site page addresses ---
# Only these known, public page files are affected. Every other .php script
# (AJAX/query endpoints under assets/db_query/, admin/, api/, and backend
# scripts like check_login.php, fetch.php, save.php, etc.) is untouched and
# keeps working exactly as before.

# 1) Old link to the homepage (/index.php) -> redirect to /
RewriteCond %{THE_REQUEST} \s/+index\.php[?\s] [NC]
RewriteRule ^ /? [R=301,L,QSA]

# 2) Old links to any other known page (/shop.php etc.) -> redirect to the
#    extension-less version (/shop), preserving any query string
RewriteCond %{THE_REQUEST} \s/+(shop|nuts|dryfruits|oils|spices|millets|rice|combo|productdetail|about|blog|contact|b2b-wholesale|cart|wishlist|checkout|order_tracking|return|privacy|term|login|logout)\.php[?\s] [NC]
RewriteRule ^ /%1 [R=301,L,QSA]

# 3) Serve the matching .php file internally when the extension-less URL is
#    requested, so the address bar keeps showing the clean URL
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(index|shop|nuts|dryfruits|oils|spices|millets|rice|combo|productdetail|about|blog|contact|b2b-wholesale|cart|wishlist|checkout|order_tracking|return|privacy|term|login|logout)$ $1.php [L,QSA]
