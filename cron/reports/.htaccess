# Daily stock reports are saved here as CSVs. They are emailed to the admin
# automatically — this folder should never be browsable or downloadable
# directly from the web, since filenames are predictable (stock_in_YYYY-MM-DD.csv).
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
